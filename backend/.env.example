# Market Mind Live - backend environment variables
#
# Copy this file to `.env` in the same folder (backend/.env) and adjust values as needed.
# Every setting below has a working default - for local development you can leave this file
# entirely blank (or skip creating it) and the app will still start. Nothing here is required
# to run the backend; GEMINI_API_KEY and AI_KEY_ENCRYPTION_SECRET are the only ones you'd add
# for optional features (see their sections below).

# Comma-separated list of origins allowed to call the API from a browser. Must include your
# frontend's URL (with scheme, no trailing slash) or the browser will block every request with
# a CORS error. Default covers the local frontend dev server.
CORS_ORIGINS=http://localhost:3000

# Environment: development | production. Only affects a couple of dev-only conveniences (e.g.
# the /api/debug/* introspection endpoints only respond outside production).
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Persistence ---
# SQLite by default (a local file, no server to run). Alerts, AI chat sessions, and
# prediction history are stored here so they survive restarts. Swap for a Postgres URL
# (e.g. postgresql+psycopg://user:pass@host:5432/dbname) if deploying somewhere with an
# ephemeral filesystem - a SQLite file won't survive a redeploy there.
DATABASE_URL=sqlite:///./market_mind.db

# --- Market data provider ---
# Live/historical quotes come from yfinance (the unofficial Yahoo Finance API). It has no
# authenticated REST endpoint, so there is no market-data API key to set here - Yahoo's
# quote/history endpoints have never required one. If a paid, key-authenticated vendor
# (Twelve Data, Finnhub, Polygon, etc.) is added later, it plugs in behind the
# `MarketDataProvider` interface in backend/data/provider.py without touching services/API
# layers, and its key would live in this file at that point.

# Seconds to cache quote/candle/history/search/FX/analyst/news responses in memory before
# refetching. Every consumer of a symbol's data (dashboard, charts, indicators, predictions,
# risk, AI assistant) shares these cached values instead of each triggering its own Yahoo call.
QUOTE_CACHE_TTL_SECONDS=10
CANDLE_CACHE_TTL_SECONDS=30
SEARCH_CACHE_TTL_SECONDS=300
FX_CACHE_TTL_SECONDS=300
# Analyst ratings/price targets move at most a few times a month, not intraday - a long TTL
# keeps this off the hot path without going stale in any practical sense.
ANALYST_CACHE_TTL_SECONDS=1800
# News headlines refresh more often than analyst ratings but still nowhere near quote/candle
# cadence - 15 minutes keeps the panel reasonably fresh without hammering Yahoo's news endpoint.
NEWS_CACHE_TTL_SECONDS=900
# Individual rating-change events are even rarer than the aggregate consensus updating - same
# TTL as ANALYST_CACHE_TTL_SECONDS for the same reason.
RATING_CHANGES_CACHE_TTL_SECONDS=1800

# Seconds between pushes to each connected WebSocket client. Independent of how often the
# server actually polls Yahoo (see HUB_* below) - many clients watching the same symbol
# share one upstream poller, so this can safely stay at 1s without multiplying outbound
# requests per viewer.
WS_POLL_INTERVAL_SECONDS=1

# Max requests per symbol per minute, and across ALL symbols combined, before we return a
# rate-limit error to the client. The global limit exists because Yahoo's undocumented
# throttling is IP-wide, not per-symbol - a dashboard watching many symbols could stay
# under every individual symbol's quota while still tripping Yahoo's real limit.
PROVIDER_RATE_LIMIT_PER_MINUTE=60
PROVIDER_GLOBAL_RATE_LIMIT_PER_MINUTE=900
# Pacing limits (requests/second) applied on top of the per-minute quotas above, smoothing
# out bursts instead of allowing the full per-minute quota to fire all at once.
PROVIDER_RATE_LIMIT_PER_SECOND=2.0
PROVIDER_GLOBAL_RATE_LIMIT_PER_SECOND=10.0

# Retry/backoff for transient network failures (DNS blips, dropped connections) when
# calling yfinance. Not for rate limiting - a real 429 from Yahoo is not retried; instead
# it trips a shared cooldown (below) so every symbol's poller backs off together.
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5

# When Yahoo itself returns a rate-limit response, every symbol's poller backs off together
# for this long before instead of each independently retrying into a still-active limit.
# Repeated hits escalate this cooldown (doubling each time, up to the max below) since a real
# Yahoo-side ban often outlasts one short cooldown - the streak resets after a call succeeds.
PROVIDER_RATE_LIMIT_COOLDOWN_SECONDS=15.0
PROVIDER_RATE_LIMIT_COOLDOWN_MAX_SECONDS=120.0

# --- Live update poller (services/live_hub.py) ---
# One background poller per actively-watched symbol, shared by every client subscribed to
# it - the cadence below is how often that poller calls yfinance for that symbol, and it
# adapts automatically to the symbol's own market session so we're not hammering Yahoo
# for a market that's closed and cannot move:
#   - HUB_QUOTE_INTERVAL_OPEN_SECONDS: while the market is open (fastest safe cadence -
#     yfinance has no true push/streaming API or documented rate limit, so 1s is a
#     conservative floor rather than a guaranteed "real-time" figure).
#   - HUB_QUOTE_INTERVAL_EXTENDED_SECONDS: pre-market / after-hours (prices move, but
#     much less actively than during the regular session).
#   - HUB_QUOTE_INTERVAL_CLOSED_SECONDS: fully closed (weekends, overnight) - the price
#     cannot change, so this can be slow.
HUB_QUOTE_INTERVAL_OPEN_SECONDS=1.0
HUB_QUOTE_INTERVAL_EXTENDED_SECONDS=5.0
HUB_QUOTE_INTERVAL_CLOSED_SECONDS=60.0
HUB_INDICATOR_INTERVAL_SECONDS=30
HUB_IDLE_SHUTDOWN_SECONDS=45
HUB_ERROR_BACKOFF_MAX_SECONDS=30

# --- Price Predictor forecast (services/prediction_service.py) ---
# A daily-bar-derived forecast doesn't meaningfully change minute-to-minute, so this is
# cached far longer than CANDLE_CACHE_TTL_SECONDS - recomputing it on every poll is wasted
# work. FORECAST_MAX_HORIZON_DAYS caps how far ahead a forecast can be requested.
FORECAST_CACHE_TTL_SECONDS=300
FORECAST_MAX_HORIZON_DAYS=30

# --- API-wide request protection ---
# Coarse per-client-IP request ceiling across every endpoint (distinct from the AI chat/
# provider-specific limiters below), sized to comfortably absorb normal dashboard use and
# only trip on genuinely abnormal request volume. Set to 0 to disable.
API_RATE_LIMIT_PER_MINUTE=600
# Hard ceiling on request body size (bytes), rejected before FastAPI/Pydantic parses the
# payload - protects against an accidentally or maliciously oversized request body.
MAX_REQUEST_BODY_BYTES=1000000
# Responses larger than this (bytes) get gzip-compressed; smaller ones (most quotes/alerts)
# skip compression overhead since it wouldn't meaningfully shrink them.
GZIP_MIN_SIZE_BYTES=1024
# How stale a device's "last seen" timestamp must be (seconds) before a request bothers
# writing an update for it - avoids a write on every single API call from an active client.
DEVICE_LAST_SEEN_UPDATE_INTERVAL_SECONDS=300

# --- AI Insights Assistant (Google Gemini) ---
# Optional. Leave GEMINI_API_KEY unset/blank to use the built-in deterministic mock provider
# for local development - every AI Insights feature (chat, streaming, follow-ups) works
# end-to-end without a key, just with canned rather than live-generated answers.
# Get a free key at https://aistudio.google.com/apikey (starts with "AIza", 39 characters).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
AI_MAX_HISTORY_MESSAGES=20
# Short-lived cache for identical (context + question) Gemini calls, so an accidental
# double-submit or an immediate retry doesn't burn a second Gemini request for an answer
# that would be identical anyway. Kept short since market context moves.
AI_RESPONSE_CACHE_TTL_SECONDS=30
# Optional. Encrypts a per-device "bring your own Gemini key" (set via the app's Settings
# page) at rest in the database. If left unset, a random key is generated in memory each time
# the server starts - fine for local development, but it means any device-saved Gemini keys
# become unreadable (and the app quietly falls back to the mock provider for that device)
# after every restart. For a production deployment, generate a stable key once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and set it here so saved keys survive restarts/redeploys.
AI_KEY_ENCRYPTION_SECRET=

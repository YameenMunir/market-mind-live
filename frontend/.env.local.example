# Market Mind Live - frontend environment variables
#
# Copy this file to `.env.local` in the same folder (frontend/.env.local). Both variables
# below are optional for local development - if you leave this file blank or don't create it,
# the app defaults to talking to a backend running on localhost:8000 (the default when you
# follow the backend's own "Getting started" instructions), which is right for most local setups.
#
# Only set these explicitly if your backend runs somewhere other than localhost:8000 (a
# different port, a remote/deployed backend, Docker, etc).

# Base URL of the backend's REST API (no trailing slash). Required to be a public,
# browser-reachable URL if you deploy the frontend - it's inlined into the built JS bundle at
# build time, so changing it after a production build/deploy requires rebuilding.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL of the backend's WebSocket endpoint (powers the live-updating dashboard). Use
# ws:// for a plain-HTTP backend (local dev) or wss:// for an HTTPS-deployed backend - the
# app also auto-upgrades ws:// to wss:// at runtime if the page itself loaded over https://,
# so this mainly matters for getting the host/port right.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
